# MongoDB connection string (Atlas, or the local one from docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017/hub-health

# NextAuth: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Only needed locally; Vercel sets the URL automatically
NEXTAUTH_URL=http://localhost:3000

# Portfolio demo: one-click "Try the demo" login + daily data reset (default: on)
NEXT_PUBLIC_DEMO_MODE=true
# Allow visitors to create real accounts (default: off)
NEXT_PUBLIC_ALLOW_REGISTRATION=false

# Protects /api/cron/reset-demo; Vercel Cron sends it as a Bearer token.
# Generate with `openssl rand -hex 32`
CRON_SECRET=
